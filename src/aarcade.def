NAME AARCADE
DESCRIPTION 'Alien Arcade'
EXETYPE WINDOWS
STUB 'D:\BIN\WINSTUB.EXE'
PROTMODE
CODE PRELOAD MOVEABLE DISCARDABLE
DATA PRELOAD MOVEABLE MULTIPLE
HEAPSIZE 1024
STACKSIZE 5120
EXPORTS
	MAINWNDPROC @1
	MODALDLGPROC @3
	SWAMPGASDLGCLSPROC @4
	USERWNDPROC @5
	SPEAKERTIMERPROC @6
	TIMERWNDPROC @7
	MSGHOOKPROC @8
